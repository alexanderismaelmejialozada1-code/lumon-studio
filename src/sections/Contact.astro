---
import ArrowIcon from '../components/ArrowIcon.astro';
import { site, whatsappHref } from '../data/site';
import SocialLinks from '../components/SocialLinks.astro';
---
<section id="contacto" class="contact" aria-labelledby="contact-title" tabindex="-1">
  <div class="container contact-grid">
    <div>
      <h2 id="contact-title">Tu próximo paso digital empieza con una conversación.</h2>
      <a class="button contact-cta" href={whatsappHref} target="_blank" rel="noopener noreferrer" aria-describedby="contact-status">{site.cta.primary}<ArrowIcon direction="right" /><span class="sr-only"> (se abre en una pestaña nueva)</span></a>
      <p id="contact-status" class="contact-status">Número provisional para desarrollo. Pendiente de confirmación antes de publicación.</p>
    </div>
    <address class="contact-options">
      <a class="contact-channel" href={whatsappHref} target="_blank" rel="noopener noreferrer">
        <span class="channel-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.35 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.84.57 2.8.69A2 2 0 0 1 22 16.92Z" /></svg></span>
        <span class="channel-copy"><span class="channel-label">Teléfono · WhatsApp</span><span class="channel-value">{site.contact.phone}</span></span>
        <span class="channel-arrow"><ArrowIcon /></span><span class="sr-only"> (se abre en una pestaña nueva)</span>
      </a>
      <a class="contact-channel" href={`mailto:${site.contact.email}`}>
        <span class="channel-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></svg></span>
        <span class="channel-copy"><span class="channel-label">Email</span><span class="channel-value email">{site.contact.email}</span></span>
        <span class="channel-arrow"><ArrowIcon /></span>
      </a>
      <div class="contact-social">
        <span class="channel-label">Redes sociales</span><SocialLinks tiles />
      </div>
    </address>
  </div>
</section>
<style>
  .contact { padding-block: clamp(5rem, 10vw, 9rem); border-block: 1px solid var(--color-steel); background: var(--color-blue-deep); }
  .contact-grid { display: grid; gap: var(--space-6); }
  h2 { max-width: 18ch; }
  .contact-cta { margin-top: var(--space-5); }
  .contact-status { margin-top: var(--space-3); color: var(--color-text-muted); font-size: .75rem; max-width: 55ch; }
  .contact-options { display: grid; gap: var(--space-2); font-style: normal; min-width: 0; }
  .contact-channel { display: grid; grid-template-columns: 44px minmax(0, 1fr) 20px; align-items: center; gap: var(--space-3); min-height: 104px; padding: var(--space-3) var(--space-4); border: 1px solid var(--color-steel); border-radius: 14px; background: var(--color-bg-elevated); text-decoration: none; transition: border-color 180ms var(--ease), background-color 180ms var(--ease), transform 160ms var(--ease); }
  .channel-icon { display: grid; place-items: center; width: 44px; height: 44px; color: var(--color-cyan); }
  .channel-copy { display: grid; gap: .375rem; min-width: 0; }
  .channel-label { color: var(--color-text-muted); font-size: .75rem; line-height: 1.5; }
  .channel-value { color: var(--color-text); font-size: clamp(.8125rem, 1.1vw, 1rem); font-weight: 550; line-height: 1.55; }
  .channel-arrow { color: var(--color-text-muted); transition: transform 180ms var(--ease), color 180ms var(--ease); }
  .contact-channel:focus-visible { outline-offset: 4px; border-color: var(--color-cyan); }
  .contact-channel:active { transform: scale(.985); }
  .contact-social { display: grid; gap: var(--space-2); padding-top: var(--space-3); }
  .email { overflow-wrap: anywhere; word-break: break-word; }
  @media (max-width: 30rem) { .contact-channel { gap: var(--space-2); padding-inline: var(--space-3); grid-template-columns: 28px minmax(0, 1fr) 16px; } .channel-icon { width: 28px; } }
  @media (hover: hover) and (pointer: fine) { .contact-channel:hover { border-color: var(--color-cyan); background: var(--color-bg); } .contact-channel:hover .channel-arrow { color: var(--color-cyan); transform: translate(2px, -2px); } }
  @media (prefers-reduced-motion: reduce) { .contact-channel, .channel-arrow { transition: none; } .contact-channel:active, .contact-channel:hover .channel-arrow { transform: none; } }
  @media (min-width: 48rem) { .contact-grid { grid-template-columns: 6fr 5fr; align-items: end; gap: clamp(3rem, 7vw, 7rem); } }
</style>
