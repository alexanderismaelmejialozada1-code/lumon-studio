---
interface Props { direction?: 'right' | 'diagonal'; class?: string; }
const { direction = 'diagonal', class: className } = Astro.props;
---
<svg class:list={['action-icon', className]} data-direction={direction} width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {direction === 'right' ? <path d="M4 12h15m-6-6 6 6-6 6" /> : <path d="M6 18 18 6M6 6h12v12" />}
</svg>
